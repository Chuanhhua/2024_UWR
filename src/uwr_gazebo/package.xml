<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uwr_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo Harmonic simulation of the UWR platform in the 15 x 25 m pool: world, ROS-Gazebo bridge, sonar scan converters (scan_to_three_sonar, scan_to_range) for the Kalman filters, and the zig-zag driver.</description>
  <maintainer email="liuchuany6@gmail.com">chuanhua</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>uwr_description</exec_depend>        <!-- the URDF -->
  <exec_depend>ros_gz_sim</exec_depend>             <!-- gz_sim.launch.py -->
  <exec_depend>ros_gz_bridge</exec_depend>          <!-- parameter_bridge -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>      <!-- sim.launch.py -->
  <exec_depend>python3-yaml</exec_depend>            <!-- sim.launch.py reads config/sim_*.yaml -->
  <!-- used by scan_to_three_sonar.py -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>            <!-- LaserScan in -->
  <exec_depend>sonar_msgs</exec_depend>             <!-- ThreeSonarDepth out -->
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>               <!-- zigzag_driver: ground truth in -->
  <exec_depend>ros_gz_interfaces</exec_depend>      <!-- zigzag_driver: EntityWrench out -->
  <exec_depend>foxglove_bridge</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
