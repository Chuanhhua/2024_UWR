  "globalVariables": {},
  "userNodes": {
    "live-sbs-m": {
      "name": "sbs_mm_to_m",
      "sourceCode": "// /sbs distances are in mm; convert to m to plot next to the KF state (/pose_topic).\nimport { Input } from \"./types\";\n\ntype Output = { distance_1: number; distance_2: number; distance_3: number };\n\nexport const inputs = [\"/sbs\"];\nexport const output = \"/studio_script/sbs_m\";\n\nexport default function script(event: Input<\"/sbs\">): Output {\n  const m = event.message;\n  return {\n    distance_1: m.distance_1 / 1000,\n    distance_2: m.distance_2 / 1000,\n    distance_3: m.distance_3 / 1000,\n  };\n}\n"
    },
    "sim-kf-error": {
      "name": "kf_error",
      "sourceCode": "// SIM ONLY. KF estimate minus ground truth, both in the pool (world) frame.\n// Truth arrives at 20 Hz and the KF at up to 100 Hz, so each KF sample is compared with\n// the latest truth: up to 50 ms old, i.e. ~5 mm at 0.1 m/s.\nimport { Input } from \"./types\";\n\ntype Output = { x: number; y: number; z: number; dist: number };\n\nexport const inputs = [\"/kf/pool_pose\", \"/pose_topic_gt\"];\nexport const output = \"/studio_script/kf_error\";\n\nlet truth: { x: number; y: number; z: number } | undefined;\n\nexport default function script(\n  event: Input<\"/kf/pool_pose\"> | Input<\"/pose_topic_gt\">,\n): Output | undefined {\n  if (event.topic === \"/pose_topic_gt\") {\n    const p = (event as Input<\"/pose_topic_gt\">).message.pose.pose.position;\n    truth = { x: p.x, y: p.y, z: p.z };\n    return undefined;\n  }\n  if (!truth) {\n    return undefined;\n  }\n  const p = (event as Input<\"/kf/pool_pose\">).message.pose.position;\n  const e = { x: p.x - truth.x, y: p.y - truth.y, z: p.z - truth.z };\n  return { ...e, dist: Math.hypot(e.x, e.y, e.z) };\n}\n"
    },
    "sim-gt-path": {
      "name": "gt_path",
      "sourceCode": "// SIM ONLY. Ground-truth trail (green) in the world frame for the 3D panel.\nimport { Input, Message } from \"./types\";\n\ntype Output = Message<\"foxglove.PosesInFrame\">;\n\nexport const inputs = [\"/pose_topic_gt\"];\nexport const output = \"/studio_script/gt_path\";\n\nconst MAX_POSES = 20000;\nlet poses: Output[\"poses\"] = [];\nlet lastNs = -1;\n\nexport default function script(event: Input<\"/pose_topic_gt\">): Output {\n  const t = event.receiveTime;\n  const ns = t.sec * 1e9 + t.nsec;\n  if (ns < lastNs) {\n    poses = []; // seeked backwards: restart the trail\n  }\n  lastNs = ns;\n  const p = event.message.pose.pose.position;\n  poses.push({ position: { x: p.x, y: p.y, z: p.z }, orientation: { x: 0, y: 0, z: 0, w: 1 } });\n  if (poses.length > MAX_POSES) {\n    poses.shift();\n  }\n  return { timestamp: t, frame_id: \"world\", poses: poses.slice() };\n}\n"
    },
    "sim-kf-path": {
      "name": "kf_pool_path",
      "sourceCode": "// SIM ONLY. KF estimate trail (red) in the world frame for the 3D panel.\nimport { Input, Message } from \"./types\";\n\ntype Output = Message<\"foxglove.PosesInFrame\">;\n\nexport const inputs = [\"/kf/pool_pose\"];\nexport const output = \"/studio_script/kf_pool_path\";\n\nconst MAX_POSES = 20000;\nlet poses: Output[\"poses\"] = [];\nlet lastNs = -1;\n\nexport default function script(event: Input<\"/kf/pool_pose\">): Output {\n  const t = event.receiveTime;\n  const ns = t.sec * 1e9 + t.nsec;\n  if (ns < lastNs) {\n    poses = []; // seeked backwards: restart the trail\n  }\n  lastNs = ns;\n  const p = event.message.pose.position;\n  poses.push({ position: { x: p.x, y: p.y, z: p.z }, orientation: { x: 0, y: 0, z: 0, w: 1 } });\n  if (poses.length > MAX_POSES) {\n    poses.shift();\n  }\n  return { timestamp: t, frame_id: \"world\", poses: poses.slice() };\n}\n"
    },
    "sim-ekf-error": {
      "name": "ekf_error",
      "sourceCode": "// SIM ONLY. Planar EKF estimate minus ground truth, both in the pool (= world) frame,\n// plus both headings in degrees (Plot can't turn a quaternion into a heading).\n// Truth arrives at 50 Hz; each EKF sample is compared with the latest truth.\nimport { Input } from \"./types\";\n\ntype Output = {\n  x: number;\n  y: number;\n  dist: number;\n  yaw_deg: number;\n  truth_yaw_deg: number;\n  ekf_yaw_deg: number;\n};\ntype Quat = { x: number; y: number; z: number; w: number };\n\nexport const inputs = [\"/ekf_planar/odom\", \"/pose_topic_gt\"];\nexport const output = \"/studio_script/ekf_error\";\n\nlet truth: { x: number; y: number; yaw: number } | undefined;\n\nfunction yawDeg(q: Quat): number {\n  return (Math.atan2(2 * (q.w * q.z + q.x * q.y), 1 - 2 * (q.y * q.y + q.z * q.z)) * 180) / Math.PI;\n}\n\nexport default function script(\n  event: Input<\"/ekf_planar/odom\"> | Input<\"/pose_topic_gt\">,\n): Output | undefined {\n  const pose = event.message.pose.pose;\n  if (event.topic === \"/pose_topic_gt\") {\n    truth = { x: pose.position.x, y: pose.position.y, yaw: yawDeg(pose.orientation) };\n    return undefined;\n  }\n  if (!truth) {\n    return undefined;\n  }\n  const yaw = yawDeg(pose.orientation);\n  const e = { x: pose.position.x - truth.x, y: pose.position.y - truth.y };\n  let dyaw = yaw - truth.yaw;\n  dyaw -= 360 * Math.round(dyaw / 360); // wrap to [-180, 180]\n  return {\n    ...e,\n    dist: Math.hypot(e.x, e.y),\n    yaw_deg: dyaw,\n    truth_yaw_deg: truth.yaw,\n    ekf_yaw_deg: yaw,\n  };\n}\n"
    },
    "sim-ekf-path": {
      "name": "ekf_path",
      "sourceCode": "// SIM ONLY. Planar EKF estimate trail (blue) in the world frame for the 3D panel.\nimport { Input, Message } from \"./types\";\n\ntype Output = Message<\"foxglove.PosesInFrame\">;\n\nexport const inputs = [\"/ekf_planar/odom\"];\nexport const output = \"/studio_script/ekf_path\";\n\nconst MAX_POSES = 20000;\nlet poses: Output[\"poses\"] = [];\nlet lastNs = -1;\n\nexport default function script(event: Input<\"/ekf_planar/odom\">): Output {\n  const t = event.receiveTime;\n  const ns = t.sec * 1e9 + t.nsec;\n  if (ns < lastNs) {\n    poses = []; // seeked backwards: restart the trail\n  }\n  lastNs = ns;\n  const p = event.message.pose.pose.position;\n  poses.push({ position: { x: p.x, y: p.y, z: p.z }, orientation: { x: 0, y: 0, z: 0, w: 1 } });\n  if (poses.length > MAX_POSES) {\n    poses.shift();\n  }\n  return { timestamp: t, frame_id: \"world\", poses: poses.slice() };\n}\n"
    }
  },
  "playbackConfig": {
    "speed": 1
  },
  "layout": "Tab!livemain"
}
